{
  "name": "loshu-sdlc",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Native SDLC plugin for Claude Code",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "pnpm -r test:coverage",
    "test:eval": "pnpm --filter @loshu89/cli test:eval",
    "test:eval:strict": "pnpm --filter @loshu89/cli test:eval:strict",
    "test:eval:record": "pnpm --filter @loshu89/cli test:eval:record",
    "test:eval:json": "pnpm --filter @loshu89/cli exec tsx ../../tests/evals/run.ts --json",
    "test:hooks": "pnpm --filter @loshu89/plugin test:hooks",
    "lint": "eslint . --ext .ts,.js,.mjs",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml,sh}\"",
    "format:check": "prettier --check \"**/*/{ts,js,json,md,yml,yaml,sh}\"",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version",
    "publish": "pnpm -r publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/fs-extra": "11.0.4",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "11.4.0",
    "prettier": "^3.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
