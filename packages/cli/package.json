{
  "name": "@loshu89/cli",
  "version": "0.5.0",
  "description": "Scaffolder and maintenance CLI for loshu-sdlc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-loshu-sdlc-app": "./dist/bin/create-loshu-sdlc-app.js",
    "loshu-sdlc": "./dist/bin/loshu-sdlc.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "templates/",
    "plugin/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && pnpm run copy-plugin",
    "copy-plugin": "node ../../scripts/copy-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:eval": "tsx ../../tests/evals/run.ts",
    "test:eval:strict": "tsx ../../tests/evals/run.ts --strict",
    "test:eval:record": "tsx ../../tests/evals/run.ts --record"
  },
  "dependencies": {
    "@loshu89/templates": "workspace:*",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.0",
    "chalk": "^6.0.0",
    "ejs": "^6.0.1",
    "execa": "^10.0.1",
    "fs-extra": "^11.2.0",
    "inquirer": "^14.2.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.19.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loshu89/loshu-sdlc.git"
  }
}
