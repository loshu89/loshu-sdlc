{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loshu-sdlc.dev/schemas/review.schema.json",
  "title": "REVIEW.md",
  "description": "Schema for SDLC review documents. See spec §8.2.",
  "type": "object",
  "required": ["id", "schema_version", "cycle_id", "stage", "state", "created_by", "created_at", "title", "bugs", "security", "compliance"],
  "properties": {
    "id": { "type": "string", "pattern": "^(plan|design|build|test|deploy|maintain)-c\\d{2,}-[a-z0-9-]+-[0-9a-f]{4}-[0-9A-HJKMNP-TV-Z]{26}$" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "cycle_id": { "type": "integer", "minimum": 1 },
    "stage": { "enum": ["deploy"] },
    "parent_ids": { "type": "array", "items": { "type": "string" } },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "authored_by": { "type": "array", "items": { "type": "object" } },
    "git": { "type": "object" },
    "title": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["draft", "accepted", "iterating", "blocked", "rejected", "archived"],
      "default": "draft",
      "description": "Formal DAG state of this artifact (see packages/plugin/state-machines/artifact.json)."
    },
    "spec": { "type": "string" },
    "plan": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "bugs": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "pass", "fail"] },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "security": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "pass", "fail"] },
        "owasp": {
          "type": "array",
          "items": { "type": "string" }
        },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compliance": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "pass", "fail"] },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}