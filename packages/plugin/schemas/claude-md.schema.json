{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loshu-sdlc.dev/schemas/claude-md.schema.json",
  "title": "CLAUDE.md",
  "description": "Schema for project CLAUDE.md files. See spec §8.2.",
  "type": "object",
  "required": ["id", "schema_version", "cycle_id", "stage", "state", "created_by", "created_at", "title", "verification"],
  "properties": {
    "id": { "type": "string", "pattern": "^(plan|design|build|test|deploy|maintain)-c\\d{2,}-[a-z0-9-]+-[0-9a-f]{4}-[0-9A-HJKMNP-TV-Z]{26}$" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "cycle_id": { "type": "integer", "minimum": 1 },
    "stage": { "enum": ["test"] },
    "parent_ids": { "type": "array", "items": { "type": "string" } },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "authored_by": { "type": "array", "items": { "type": "object" } },
    "git": { "type": "object" },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": ["draft", "accepted", "iterating", "blocked", "rejected", "archived"],
      "default": "draft",
      "description": "Formal DAG state of this artifact (see packages/plugin/state-machines/artifact.json)."
    },
    "generatedBy": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "stack": {
      "type": "object"
    },
    "verification": {
      "type": "object",
      "required": ["build", "test", "lint"],
      "properties": {
        "build": { "type": "string" },
        "test": { "type": "string" },
        "lint": { "type": "string" },
        "typecheck": { "type": "string" }
      }
    },
    "conventions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}