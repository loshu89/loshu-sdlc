{
  "name": "@loshu89/plugin",
  "version": "0.7.0",
  "description": "Claude Code plugin for AI-Native SDLC",
  "license": "MIT",
  "type": "module",
  "main": "./.claude-plugin/plugin.json",
  "files": [
    ".claude-plugin/",
    "commands/",
    "skills/",
    "agents/",
    "hooks/",
    "schemas/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "bash hooks/tests/debounce.test.sh && bash hooks/tests/find-cli.test.sh",
    "test:hooks": "bash hooks/tests/debounce.test.sh && bash hooks/tests/find-cli.test.sh",
    "typecheck": "echo \"plugin is markdown/JSON, no typecheck\" && exit 0",
    "build": "echo \"plugin is markdown/JSON, no build\" && exit 0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loshu89/loshu-sdlc.git"
  }
}
